        </mxCell>
        <mxCell id="l1X7b_PrmKpSjkn1pbCN-25" parent="WIyWlLk6GJQsqaUBKTNV-1" style="whiteSpace=wrap;html=1;" value="1. If it is answerd correctly without taking hint:&lt;div&gt;&amp;nbsp;Full question marks&lt;/div&gt;" vertex="1">
          <mxGeometry height="60" width="120" x="2220" y="-270" as="geometry" />
        </mxCell>
        <mxCell id="l1X7b_PrmKpSjkn1pbCN-26" parent="WIyWlLk6GJQsqaUBKTNV-1" style="whiteSpace=wrap;html=1;" value="2. If it is answerd correctly by taking hint:&lt;div&gt;&amp;nbsp;Full question marks - hint marks&lt;/div&gt;" vertex="1">
          <mxGeometry height="80" width="190" x="2200" y="-190" as="geometry" />
        </mxCell>
        <mxCell id="l1X7b_PrmKpSjkn1pbCN-27" parent="WIyWlLk6GJQsqaUBKTNV-1" style="whiteSpace=wrap;html=1;" value="3. If it is answerd wrong by taking hint:&amp;nbsp;&amp;nbsp;&lt;div&gt;- hint marks - negative marks&lt;/div&gt;" vertex="1">
          <mxGeometry height="60" width="160" x="2215" y="-90" as="geometry" />
        </mxCell>
        <mxCell id="l1X7b_PrmKpSjkn1pbCN-28" parent="WIyWlLk6GJQsqaUBKTNV-1" style="whiteSpace=wrap;html=1;" value="4. If it is unanswerd by taking hint:&amp;nbsp;&amp;nbsp;&lt;div&gt;- hint marks&lt;/div&gt;" vertex="1">
          <mxGeometry height="60" width="160" x="2215" y="-13.449999999999989" as="geometry" />
        </mxCell>
        <mxCell id="l1X7b_PrmKpSjkn1pbCN-29" parent="WIyWlLk6GJQsqaUBKTNV-1" style="whiteSpace=wrap;html=1;" value="5. If it is unanswerd without taking hint:&amp;nbsp;&amp;nbsp;&lt;div&gt;No marks&lt;/div&gt;" vertex="1">
          <mxGeometry height="60" width="160" x="2215" y="69.77999999999997" as="geometry" />
        </mxCell>
        <mxCell id="l1X7b_PrmKpSjkn1pbCN-30" parent="WIyWlLk6GJQsqaUBKTNV-1" style="whiteSpace=wrap;html=1;" value="6. If answer is partially correct:&amp;nbsp;&amp;nbsp;&lt;div&gt;(full_marks*no.of.correctly_answered_options)/(total_no.of.correct_options)&lt;/div&gt;" vertex="1">
