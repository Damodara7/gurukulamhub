        <mxCell id="l1X7b_PrmKpSjkn1pbCN-24" parent="WIyWlLk6GJQsqaUBKTNV-1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;glass=0;strokeWidth=1;shadow=0;" value="&lt;h3&gt;5. Quiz marks Calculation&lt;/h3&gt;" vertex="1">
