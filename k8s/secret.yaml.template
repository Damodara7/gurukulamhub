# This is a template file. Copy it to secret.yaml and fill in your actual values.
# DO NOT commit secret.yaml to version control!
#
# To create the secret, run:
# kubectl create secret generic gurukulamhub-secrets --from-file=secret.yaml -n gurukulamhub
#
# Or use:
# kubectl create secret generic gurukulamhub-secrets \
#   --from-literal=DATABASE_URL='your-database-url' \
#   --from-literal=NEXTAUTH_SECRET='your-secret' \
#   -n gurukulamhub

apiVersion: v1
kind: Secret
metadata:
  name: gurukulamhub-secrets
  namespace: gurukulamhub
type: Opaque
stringData:
  # -----------------------------------------------------------------------------
  # App Configuration
  # -----------------------------------------------------------------------------
  BASEPATH: ""
  DOMAIN: "gurukulamhub.org"
  NEXT_PUBLIC_APP_URL: "https://gurukulamhub.org"
  NEXT_PUBLIC_DOCS_URL: "https://demos.themeselection.com/materio-mui-react-nextjs-admin-template/documentation"
  USE_FALLBACK_MUTATION: "true"
  
  # -----------------------------------------------------------------------------
  # Authentication (NextAuth.js) - SENSITIVE
  # -----------------------------------------------------------------------------
  NEXTAUTH_BASEPATH: "/api/auth"
  NEXTAUTH_URL: "https://gurukulamhub.org"
  AUTH_TRUST_HOST: "https://gurukulamhub.org"
  NEXTAUTH_SECRET: "your-nextauth-secret-key-here"  # ⚠️ SENSITIVE
  
  # -----------------------------------------------------------------------------
  # Google OAuth 2.0
  # -----------------------------------------------------------------------------
  GOOGLE_CLIENT_ID: "your-google-client-id"
  GOOGLE_CLIENT_SECRET: "your-google-client-secret"  # ⚠️ SENSITIVE
  
  # -----------------------------------------------------------------------------
  # Database Configuration - ⚠️ VERY SENSITIVE (contains password)
  # -----------------------------------------------------------------------------
  DATABASE_URL: "mongodb+srv://user:password@cluster.mongodb.net/dbname?retryWrites=true&w=majority&appName=Cluster0"
  MONGODB_URI: "mongodb+srv://user:password@cluster.mongodb.net/dbname?retryWrites=true&w=majority&appName=Cluster0"
  MONGODB_DB: "gurkulhub"
  
  # -----------------------------------------------------------------------------
  # API Configuration
  # -----------------------------------------------------------------------------
  API_URL: "https://gurukulamhub.org/api"
  NEXT_PUBLIC_API_URL: "https://gurukulamhub.org/api"
  
  # -----------------------------------------------------------------------------
  # Redis Configuration
  # -----------------------------------------------------------------------------
  REDIS_PORT: "6379"
  REDIS_HOST: "gurukulamhub-redis"
  REDIS_URL: "redis://gurukulamhub-redis:6379"
  # If Redis has password: "redis://:password@gurukulamhub-redis:6379"
  
  # -----------------------------------------------------------------------------
  # AWS S3 Configuration - ⚠️ VERY SENSITIVE (Access Keys!)
  # -----------------------------------------------------------------------------
  NEXT_PUBLIC_AWS_S3_ACCESS_KEY_ID: "your-aws-access-key-id"
  NEXT_PUBLIC_AWS_S3_ACCESS_KEY_SECRET: "your-aws-secret-access-key"  # ⚠️ VERY SENSITIVE
  NEXT_PUBLIC_AWS_S3_GAMES_UPLOAD_BUCKET: "squizmegames"
  NEXT_PUBLIC_AWS_S3_REGION: "ap-south-1"
  NEXT_PUBLIC_AWS_S3_USERPROFILE_UPLOAD_BUCKET: "squizme-userprofile"
  NEXT_PUBLIC_AWS_S3_QUIZ_UPLOAD_BUCKET: "squizme-quiz"
  
  # -----------------------------------------------------------------------------
  # Google ReCAPTCHA
  # -----------------------------------------------------------------------------
  NEXT_PUBLIC_RECAPTCHA_SITE_KEY: "6LdybtIrAAAAAB1ZeuTJ-m-okYqu4tN2YN2Fkjms"  # Public key (can be in ConfigMap)
  RECAPTCHA_SECRET_KEY: "your-recaptcha-secret-key"  # ⚠️ SENSITIVE
  
  # -----------------------------------------------------------------------------
  # Socket Server
  # -----------------------------------------------------------------------------
  NEXT_PUBLIC_SOCKET_IO_SERVER: "https://gurukulamhub.org"
  SOCKET_SERVER_URL: "https://gurukulamhub.org"
  
  # -----------------------------------------------------------------------------
  # Stripe Configuration
  # -----------------------------------------------------------------------------
  NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY: "pk_test_..."  # Public key (can be in ConfigMap)
  NEXT_PUBLIC_STRIPE_SECRET_KEY: "sk_test_..."  # ⚠️ SENSITIVE - secret key
  
  # -----------------------------------------------------------------------------
  # Admin Configuration
  # -----------------------------------------------------------------------------
  SUPER_ADMIN_EMAIL: "your-admin@email.com"
  
  # Note: Values marked with ⚠️ SENSITIVE must be kept secret
  # Public keys (NEXT_PUBLIC_*) can optionally be moved to ConfigMap if preferred

